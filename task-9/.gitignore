# Build output, regenerated by scripts/export_model.py, not versioned
# (the point is CI/local both regenerate it fresh from real or synthetic
# data, not that everyone shares one committed binary).
model_artifact/

# Terraform local working state, provider plugins, and plan files.
# .terraform.lock.hcl (the provider version lock) is NOT ignored, that
# one is meant to be committed.
terraform/.terraform/
terraform/tfplan
terraform/*.tfplan
